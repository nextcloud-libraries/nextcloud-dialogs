msgstr "Název"

msgid "Names may be at most 64 characters long."
msgstr "Je třeba, aby délka jmen nepřesahovala 64 znaků."

msgid "Names must not be empty."
msgstr "Názvy je třeba vyplnit."

msgid "Names must not end with \"{extension}\"."
msgstr "Názvy nemohou končit na „{extension}“."

msgid "Names must not start with a dot."
msgstr "Názvy nemohou začínat tečkou."

