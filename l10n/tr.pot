msgstr "Dosyalar uygulamasının görünümleri yüklenemedi"

msgid "Create directory"
msgstr "Klasör oluştur"

msgid "Current view selector"
msgstr "Geçerli görünüm seçici"

msgid "Enter your name"
msgstr "Adınızı yazın"

msgid "Error: {message}"
msgstr "Hata: {message}"

msgid "Existing files"
msgstr "Var olan dosyalar"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"İşaretlenmediğinde var olan dosyalar ve klasörler silinir. İkisi de "
"seçilirse, bu ögeler yeniden adlandırılır."

msgid "Existing version"
msgstr "Var olan sürüm"

msgid "Failed to set nickname."
msgstr "Takma ad ayarlanamadı."

msgid "Favorites"
msgstr "Sık kullanılanlar"

msgid "Files and folders you mark as favorite will show up here."
msgstr "Sık kullanılan olarak seçtiğiniz dosyalar burada görüntülenir."

msgid "Files and folders you recently modified will show up here."
msgstr ""
"Son zamanlarda değiştirdiğiniz dosya ve klasörler burada görüntülenir."

msgid "Filter file list"
msgstr "Dosya listesini süz"

msgid "Folder names must not end with \"{extension}\"."
msgstr "Klasör adları \"{extension}\" ile bitemez."

msgid "Guest identification"
msgstr "Konuk kimliği"

msgid "Home"
msgstr "Giriş"

msgid "Info: {message}"
msgstr "Bilgi: {message}"

msgid "Invalid folder name."
msgstr "Klasör adı geçersiz."

msgid "Invalid name."
msgstr "Ad geçersiz."

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"{dirname} içinde aynı adlı ögeler var, hangilerinin tutulacağını seçin."

msgid "Keep both"
msgstr "İkisi de tutulsun"

msgid "Last modified date unknown"
msgstr "Son değiştirilme tarihi bilinmiyor."

msgid "Modified"
msgstr "Değiştirilme"

msgid "Move"
msgstr "Taşı"

