msgid "\"{char}\" is not allowed inside a folder name."
msgstr "\"{char}\" is niet toegestaan in een mapnaam."

msgid "\"{char}\" is not allowed inside a name."
msgstr "\"{char}\" kan niet gebruikt worden in de benaming."

msgid "\"{extension}\" is not an allowed name."
msgstr "\"{extension}\" is geen toegestane naam."

msgid "\"{segment}\" is a reserved name and not allowed for folder names."
msgstr "\"{segment}\" is een gereserveerde naam en niet toegestaan voor mapnamen."

msgid "\"{segment}\" is a reserved name and not allowed."
msgstr "\"{segment}\" is een gereserveerde naam en niet toegestaan."

msgid "All files"
msgstr "Alle bestanden"

msgid "An item with the same name already exists in {dirname}."
msgstr "Er bestaat al een item met dezelfde naam in {dirname}."

msgid "Cancel"
msgstr "Annuleren"

msgid "Cancel the entire operation"
msgstr "Annuleer de hele bewerking"

msgid "Choose"
msgstr "Kiezen"

msgid "Choose {file}"
msgstr "Kies {file}"

msgid "Choose %n file"
msgid_plural "Choose %n files"
msgstr[0] "Kies %n bestand"
msgstr[1] "Kies %n bestanden"

msgid "Close"
msgstr "Sluiten"

msgid "Confirm"
msgstr "Bevestigen"

msgid "Continue"
msgstr "Doorgaan"

msgid "Copy"
msgstr "Kopiëren"

msgid "Copy to {target}"
msgstr "Kopiëren naar {target}"

msgid "Could not create the new folder"
msgstr "Kon de nieuwe map niet aanmaken"

msgid "Could not load files settings"
msgstr "Instellingen voor bestanden konden niet worden geladen"

msgid "Could not load files views"
msgstr "Weergaven voor bestanden konden niet worden geladen"

msgid "Create directory"
msgstr "Map aanmaken"

msgid "Current view selector"
msgstr "Huidige weergave keuze"

msgid "Enter your name"
msgstr "Voer je naam in"

msgid "Error: {message}"
msgstr "Fout: {message}"

msgid "Existing files"
msgstr "Bestaande bestanden"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Bestaande bestanden en mappen worden verwijderd als ze niet worden "
"geselecteerd. Als beide worden geselecteerd, krijgen ze een nieuwe naam."

msgid "Existing version"
msgstr "Bestaande versie"

msgid "Failed to set nickname."
msgstr "Instellen bijnaam is mislukt."

msgid "Favorites"
msgstr "Favorieten"

msgid "Files and folders you mark as favorite will show up here."
msgstr ""
"Bestanden en mappen die je als favoriet markeert, worden hier weergegeven."

msgid "Files and folders you recently modified will show up here."
msgstr ""
"Bestanden en mappen die je onlangs hebt gewijzigd, worden hier weergegeven."

msgid "Filter file list"
msgstr "Bestandslijst filteren"

msgid "Folder names must not end with \"{extension}\"."
msgstr "Mapnamen mogen niet eindigen op \"{extension}\"."

msgid "Guest identification"
msgstr "Gastenidentificatie"

msgid "Home"
msgstr "Thuis"

msgid "Info: {message}"
msgstr "Info: {message}"

msgid "Invalid folder name."
msgstr "Ongeldige mapnaam."

msgid "Invalid name."
msgstr "Ongeldige naam."

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Er bestaan al items met dezelfde naam in {dirname},  kies welke je wilt "
"behouden."

msgid "Keep both"
msgstr "Beide behouden"

msgid "Last modified date unknown"
msgstr "Datum laatste aanpassing onbekend"

msgid "Modified"
msgstr "Aangepast"

msgid "Move"
msgstr "Verplaatsen"

msgid "Move to {target}"
msgstr "Verplaatsen naar {target}"

msgid "Name"
msgstr "Naam"

msgid "Names may be at most 64 characters long."
msgstr "Namen mogen maximaal 64 tekens lang zijn."

msgid "Names must not be empty."
msgstr "Namen mogen niet leeg zijn."

msgid "Names must not end with \"{extension}\"."
msgstr "Namen mogen niet eindigen met \"{extension}\"."

msgid "Names must not start with a dot."
msgstr "Namen mogen niet beginnen met een punt."

msgid "New"
msgstr "Nieuw"

msgid "New files"
msgstr "Nieuwe bestanden"

msgid "New folder"
msgstr "Nieuwe map"

msgid "New folder name"
msgstr "Nieuwe mapnaam"

msgid "New version"
msgstr "Nieuwe versie"

msgid "No files in here"
msgstr "Hier staan geen bestanden"

msgid "No files matching your filter were found."
msgstr "Geen bestanden gevonden die voldoen aan je filter."

msgid "No matching files"
msgstr "Geen overeenkomende bestanden"

msgid "Please enter a name with at least 2 characters."
msgstr "Voer een naam in met minimaal 2 tekens."

msgid "Recent"
msgstr "Recent"

msgid "Replace"
msgstr "Vervangen"

msgid "Select all checkboxes"
msgstr "Selecteer alle aanvinkopties"

msgid "Select all entries"
msgstr "Alle vermeldingen selecteren"

msgid "Select entry"
msgstr "Vermelding selecteren"

msgid "Select file to keep"
msgstr "Selecteer bestand om te behouden"

msgid "Select files to keep"
msgstr "Selecteer bestanden om te behouden"

msgid "Select the row for {nodename}"
msgstr "Selecteer de rij voor {nodename}"

msgid "Size"
msgstr "Grootte"

msgid "Skip %n file"
msgid_plural "Skip %n files"
msgstr[0] "Sla %n bestand over"
msgstr[1] "Sla %n bestanden over"

msgid "Submit name"
msgstr "Naam indienen"

msgid "Success: {message}"
msgstr "Succesvol: {message}"

msgid "Undo"
msgstr "Ongedaan maken"

msgid "Upload some content or sync with your devices!"
msgstr "Upload inhoud of synchroniseer met je apparaten!"

msgid "Warning: {message}"
msgstr "Waarschuwing: {message}"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Wanneer een nieuwe map wordt geselecteerd, worden eventuele conflicterende "
"bestanden daarin ook overschreven."

msgid ""
"When a new folder is selected, any files within it will also be overwritten."
msgstr ""
"Wanneer een nieuwe map wordt geselecteerd, worden alle bestanden daarin ook "
"overschreven."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Wanneer een nieuwe map wordt geselecteerd, wordt de inhoud naar de bestaande"
" map gekopieerd en wordt er een recursieve conflictoplossing uitgevoerd."

msgid "You are currently identified as {nickname}."
msgstr "Je wordt momenteel geïdentificeerd als {nickname}."

msgid "You are currently not identified."
msgstr "Je bent momenteel niet geïdentificeerd."

msgid "You cannot leave the name empty."
msgstr "Je kunt de naam niet leeg laten."

msgid "You need to choose at least one conflict solution"
msgstr "Je moet ten minste één manier kiezen om het conflict op te lossen"

msgid "You need to select at least one version of each file to continue."
msgstr ""
"Je moet ten minste één versie van elk bestand selecteren om door te gaan."
