msgid "\"{char}\" is not allowed inside a folder name."
msgstr "\"{char}\" er ikke tilladt i et mappenavn."

msgid "\"{char}\" is not allowed inside a name."
msgstr "\"{char}\" er ikke tilladt i et navn."

msgid "\"{extension}\" is not an allowed name."
msgstr "\"{extension}\" er ikke et tilladt navn."

msgid "\"{segment}\" is a reserved name and not allowed for folder names."
msgstr "\"{segment}\" er et reserveret navn og er ikke tilladt som mappenavn."

msgid "\"{segment}\" is a reserved name and not allowed."
msgstr "\"{segment}\" er et reserveret navn og er ikke tilladt."

msgid "All files"
msgstr "Alle filer"

msgid "An item with the same name already exists in {dirname}."
msgstr "Et element med samme navn findes allerede i {dirname}."

msgid "Cancel"
msgstr "Annuller"

msgid "Cancel the entire operation"
msgstr "Annuller hele handlingen"

msgid "Choose"
msgstr "Vælg"

msgid "Choose {file}"
msgstr "Vælg {file}"

msgid "Choose %n file"
msgid_plural "Choose %n files"
msgstr[0] "Vælg %n fil"
msgstr[1] "Vælg %n filer"

msgid "Close"
msgstr "Luk"

msgid "Confirm"
msgstr "Bekræft"

msgid "Continue"
msgstr "Fortsæt"

msgid "Copy"
msgstr "Kopiér"

msgid "Copy to {target}"
msgstr "Kopiér til {target}"

msgid "Could not create the new folder"
msgstr "Den nye mappe kunne ikke oprettes"

msgid "Could not load files settings"
msgstr "Filindstillingerne kunne ikke indlæses"

msgid "Could not load files views"
msgstr "Filvisningerne kunne ikke indlæses"

msgid "Create directory"
msgstr "Opret mappe"

msgid "Current view selector"
msgstr "Vælger for aktuel visning"

msgid "Enter your name"
msgstr "Indtast dit navn"

msgid "Error: {message}"
msgstr "Fejl: {message}"

msgid "Existing files"
msgstr "Eksisterende filer"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Eksisterende filer og mapper slettes, hvis de ikke er valgt. Hvis begge er "
"valgt, bliver de omdøbt."

msgid "Existing version"
msgstr "Eksisterende version"

msgid "Failed to set nickname."
msgstr "Kaldenavnet kunne ikke gemmes."

msgid "Favorites"
msgstr "Favoritter"

msgid "Files and folders you mark as favorite will show up here."
msgstr "Filer og mapper, du markerer som favoritter, vises her."

msgid "Files and folders you recently modified will show up here."
msgstr "Filer og mapper, du for nylig har ændret, vises her."

msgid "Filter file list"
msgstr "Filtrer fillisten"

msgid "Folder names must not end with \"{extension}\"."
msgstr "Mappenavne må ikke ende med \"{extension}\"."

msgid "Guest identification"
msgstr "Gæsteidentifikation"

msgid "Home"
msgstr "Hjem"

msgid "Info: {message}"
msgstr "Info: {message}"

msgid "Invalid folder name."
msgstr "Ugyldigt mappenavn."

msgid "Invalid name."
msgstr "Ugyldigt navn."

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Der findes allerede elementer med samme navn i {dirname}. Vælg, hvilke der "
"skal beholdes."

msgid "Keep both"
msgstr "Behold begge dele"

msgid "Last modified date unknown"
msgstr "Dato for seneste ændring er ukendt"

msgid "Modified"
msgstr "Ændret"

msgid "Move"
msgstr "Flyt"

msgid "Move to {target}"
msgstr "Flyt til {target}"

msgid "Name"
msgstr "Navn"

msgid "Names may be at most 64 characters long."
msgstr "Navne kan højst være 64 tegn lange."

msgid "Names must not be empty."
msgstr "Navne må ikke være tomme."

msgid "Names must not end with \"{extension}\"."
msgstr "Navne må ikke ende på \"{extension}\"."

msgid "Names must not start with a dot."
msgstr "Navne må ikke starte med et punktum."

msgid "New"
msgstr "Ny"

msgid "New files"
msgstr "Nye filer"

msgid "New folder"
msgstr "Ny mappe"

msgid "New folder name"
msgstr "Navn på ny mappe"

msgid "New version"
msgstr "Ny version"

msgid "No files in here"
msgstr "Ingen filer her"

msgid "No files matching your filter were found."
msgstr "Der blev ikke fundet nogen filer, der matcher dit filter."

msgid "No matching files"
msgstr "Ingen matchende filer"

msgid "Please enter a name with at least 2 characters."
msgstr "Indtast et navn med mindst 2 tegn."

msgid "Recent"
msgstr "Seneste"

msgid "Replace"
msgstr "Erstat"

msgid "Select all checkboxes"
msgstr "Markér alle afkrydsningsfelter"

msgid "Select all entries"
msgstr "Vælg alle poster"

msgid "Select entry"
msgstr "Vælg post"

msgid "Select file to keep"
msgstr "Vælg den fil, der skal beholdes"

msgid "Select files to keep"
msgstr "Vælg de filer, der skal beholdes"

msgid "Select the row for {nodename}"
msgstr "Vælg rækken for {nodename}"

msgid "Size"
msgstr "Størrelse"

msgid "Skip %n file"
msgid_plural "Skip %n files"
msgstr[0] "Spring %n fil over"
msgstr[1] "Spring %n filer over"

msgid "Submit name"
msgstr "Send navn"

msgid "Success: {message}"
msgstr "Succes: {message}"

msgid "Undo"
msgstr "Fortryd"

msgid "Upload some content or sync with your devices!"
msgstr "Overfør noget indhold, eller synkroniser med dine enheder!"

msgid "Warning: {message}"
msgstr "Advarsel: {message}"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Når en ny mappe vælges, bliver eventuelle filer i den, der er i konflikt, "
"også overskrevet."

msgid ""
"When a new folder is selected, any files within it will also be overwritten."
msgstr "Når en ny mappe vælges, bliver alle filer i den også overskrevet."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Når en ny mappe vælges, skrives indholdet ind i den eksisterende mappe, og "
"konflikterne løses rekursivt."

msgid "You are currently identified as {nickname}."
msgstr "Du er i øjeblikket identificeret som {nickname}."

msgid "You are currently not identified."
msgstr "Du er ikke identificeret."

msgid "You cannot leave the name empty."
msgstr "Navnet må ikke være tomt."

msgid "You need to choose at least one conflict solution"
msgstr "Du skal vælge mindst én konfliktløsning"

msgid "You need to select at least one version of each file to continue."
msgstr "Du skal vælge mindst én version af hver fil for at fortsætte."
