"Language: ru\n"
"Plural-Forms: nplurals=4; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? 1 : n%10==0 || (n%10>=5 && n%10<=9) || (n%100>=11 && n%100<=14)? 2 : 3);\n"

msgid "\"{char}\" is not allowed inside a folder name."
msgstr "Символ «{char}» недопустим в имени папки."

msgid "\"{char}\" is not allowed inside a name."
msgstr "Символ «{char}» недопустим в имени."

msgid "\"{extension}\" is not an allowed name."
msgstr "«{extension}» — недопустимое имя."

msgid "\"{segment}\" is a reserved name and not allowed for folder names."
msgstr "Имя «{segment}» зарезервировано и недопустимо для папок."

msgid "\"{segment}\" is a reserved name and not allowed."
msgstr "Имя «{segment}» зарезервировано и недопустимо."

msgid "All files"
msgstr "Все файлы"

msgid "An item with the same name already exists in {dirname}."
msgstr "Объект с таким именем уже существует в {dirname}."

msgid "Cancel"
msgstr "Отмена"

msgid "Cancel the entire operation"
msgstr "Отменить всю операцию"

msgid "Choose"
msgstr "Выбрать"

msgid "Choose {file}"
msgstr "Выбрать «{file}»"

msgid "Choose %n file"
msgid_plural "Choose %n files"
msgstr[0] "Выбрать %n файл"
msgstr[1] "Выбрать %n файла"
msgstr[2] "Выбрать %n файлов"
msgstr[3] "Выбрать %n файлов"

msgid "Close"
msgstr "Закрыть"

msgid "Confirm"
msgstr "Подтвердить"

msgid "Continue"
msgstr "Продолжить"

msgid "Copy"
msgstr "Копировать"

msgid "Copy to {target}"
msgstr "Копировать в «{target}»"

msgid "Could not create the new folder"
msgstr "Не удалось создать новую папку"

msgid "Could not load files settings"
msgstr "Не удалось загрузить параметры файлов"

msgid "Could not load files views"
msgstr "Не удалось загрузить разделы файлов"

msgid "Create directory"
msgstr "Создать папку"

msgid "Current view selector"
msgstr "Переключатель текущего вида"

msgid "Enter your name"
msgstr "Введите своё имя"

msgid "Error: {message}"
msgstr "Ошибка: {message}"

msgid "Existing files"
msgstr "Существующие файлы"

msgid ""
"Existing files and folders will be deleted if not selected. If both are "
"chosen, they will be renamed."
msgstr ""
"Невыбранные существующие файлы и папки будут удалены. Если выбрать обе "
"версии, они будут переименованы."

msgid "Existing version"
msgstr "Текущая версия"

msgid "Failed to set nickname."
msgstr "Не удалось задать имя."

msgid "Favorites"
msgstr "Избранное"

msgid "Files and folders you mark as favorite will show up here."
msgstr "Здесь появятся файлы и папки, добавленные в избранное."

msgid "Files and folders you recently modified will show up here."
msgstr "Здесь появятся недавно изменённые вами файлы и папки."

msgid "Filter file list"
msgstr "Фильтровать список файлов"

msgid "Folder names must not end with \"{extension}\"."
msgstr "Имена папок не могут оканчиваться на «{extension}»."

msgid "Guest identification"
msgstr "Идентификация гостя"

msgid "Home"
msgstr "Домой"

msgid "Info: {message}"
msgstr "Информация: {message}"

msgid "Invalid folder name."
msgstr "Недопустимое имя папки."

msgid "Invalid name."
msgstr "Недопустимое имя."

msgid ""
"Items with the same name already exist in {dirname}, select which to keep."
msgstr ""
"Объекты с такими же именами уже существуют в {dirname}. Выберите, какие "
"сохранить."

msgid "Keep both"
msgstr "Сохранить оба"

msgid "Last modified date unknown"
msgstr "Дата последнего изменения неизвестна"

msgid "Modified"
msgstr "Изменён"

msgid "Move"
msgstr "Переместить"

msgid "Move to {target}"
msgstr "Переместить в «{target}»"

msgid "Name"
msgstr "Имя"

msgid "Names may be at most 64 characters long."
msgstr "Имена не могут быть длиннее 64 символов."

msgid "Names must not be empty."
msgstr "Имена не могут быть пустыми."

msgid "Names must not end with \"{extension}\"."
msgstr "Имена не могут оканчиваться на «{extension}»."

msgid "Names must not start with a dot."
msgstr "Имена не должны начинаться с точки."

msgid "New"
msgstr "Создать"

msgid "New files"
msgstr "Новые файлы"

msgid "New folder"
msgstr "Новая папка"

msgid "New folder name"
msgstr "Имя новой папки"

msgid "New version"
msgstr "Новая версия"

msgid "No files in here"
msgstr "Здесь нет файлов"

msgid "No files matching your filter were found."
msgstr "По заданному фильтру файлы не найдены."

msgid "No matching files"
msgstr "Нет подходящих файлов"

msgid "Please enter a name with at least 2 characters."
msgstr "Введите имя длиной не менее 2 символов."

msgid "Recent"
msgstr "Недавние"

msgid "Replace"
msgstr "Заменить"

msgid "Select all checkboxes"
msgstr "Выбрать все флажки"

msgid "Select all entries"
msgstr "Выбрать все записи"

msgid "Select entry"
msgstr "Выбрать запись"

msgid "Select file to keep"
msgstr "Выберите, какой из файлов сохранить"

msgid "Select files to keep"
msgstr "Выберите, какие файлы сохранить"

msgid "Select the row for {nodename}"
msgstr "Выбрать строку для «{nodename}»"

msgid "Size"
msgstr "Размер"

msgid "Skip %n file"
msgid_plural "Skip %n files"
msgstr[0] "Пропустить %n файл"
msgstr[1] "Пропустить %n файла"
msgstr[2] "Пропустить %n файлов"
msgstr[3] "Пропустить %n файлов"

msgid "Submit name"
msgstr "Отправить имя"

msgid "Success: {message}"
msgstr "Успешно: {message}"

msgid "Undo"
msgstr "Отменить"

msgid "Upload some content or sync with your devices!"
msgstr "Загрузите файлы или синхронизируйте их со своими устройствами!"

msgid "Warning: {message}"
msgstr "Предупреждение: {message}"

msgid ""
"When a new folder is selected, any conflicting files within it will also be "
"overwritten."
msgstr ""
"Если выбрать новую папку, конфликтующие файлы в ней тоже будут перезаписаны."

msgid ""
"When a new folder is selected, any files within it will also be overwritten."
msgstr "Если выбрать новую папку, все файлы в ней тоже будут перезаписаны."

msgid ""
"When a new folder is selected, the content is written into the existing "
"folder and a recursive conflict resolution is performed."
msgstr ""
"Если выбрать новую папку, её содержимое будет записано в существующую, а "
"конфликты будут разрешены рекурсивно."

msgid "You are currently identified as {nickname}."
msgstr "Вы идентифицированы как {nickname}."

msgid "You are currently not identified."
msgstr "Сейчас вы не идентифицированы."

msgid "You cannot leave the name empty."
msgstr "Имя не может быть пустым."

msgid "You need to choose at least one conflict solution"
msgstr "Выберите хотя бы один способ разрешения конфликта"

msgid "You need to select at least one version of each file to continue."
msgstr "Чтобы продолжить, выберите хотя бы одну версию каждого файла."
